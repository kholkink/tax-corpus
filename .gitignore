# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Локальный PostgreSQL (бинарники + данные)
.pg/

# Сырые и большие файлы данных (не для VCS; provenance хранится в БД)
data/raw/minjust_js/
data/raw/*.json
data/raw/*.html
data/raw/*.txt
data/raw/cookies.txt

# Производные данные парсера (десятки МБ, регенерируются командой parse)
data/processed/*.jsonl
data/processed/*.txt
data/raw/sources/
*:Zone.Identifier
data/raw/fns/
data/raw/minfin/
.venv-linux/
.env
data/raw/courts/

# семантический индекс (десятки МБ, строится командой embed)
data/index/

# дела юристов (конфиденциально; пример — workspaces/demo)
workspaces/*
!workspaces/demo/

# профили провайдера с адресами (ключи — только через переменные окружения)
config/providers.json
backups/
config/users.json
