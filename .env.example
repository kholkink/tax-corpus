# Скопируйте в .env (в .gitignore). Ключи — только здесь, никогда в коде и git.
ANTHROPIC_API_KEY=sk-...
# Anthropic-совместимый провайдер (DeepSeek): без строки ниже — Anthropic напрямую
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
TAXCORPUS_MODEL=deepseek-chat
# БД: локально (embedded Postgres) или docker compose (переопределяется в compose)
TAXCORPUS_DB=postgresql://postgres@127.0.0.1:5433/taxcorpus
POSTGRES_PASSWORD=taxcorpus
# реранкер кросс-энкодером над гибридным поиском (GPU/прод): 1 или имя модели
# TAXCORPUS_RERANK=1
# чувствительные дела без локального профиля — облако с маскировкой ПДн
# TAXCORPUS_ALLOW_CLOUD_SENSITIVE=1
